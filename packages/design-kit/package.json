{
    "name": "@jasonsdevspace/design-kit",
    "version": "0.8.4",
    "description": "Design tokens, also in the Design Tokens Community Group format, base styles, a theme script, and the pieces of the demos on jasonsdevspace.com: page chrome and a site header, a content page, bands and a group of sections for a landing page, an explainer, buttons, fields, callouts, tabs, pills, an icon, a theme switch, a copy button and a status line, rows and tiles, panels and a raised panel, and an app's frame, tab bar, toast, grid of buttons, stepper and dialog.",
    "keywords": [
        "design-tokens",
        "design-system",
        "css",
        "cascade-layers",
        "dark-mode",
        "light-dark",
        "theme",
        "vite-plugin",
        "react"
    ],
    "license": "MIT",
    "author": "Jason Poteet",
    "homepage": "https://github.com/jasonsdevspace/design-kit/tree/main/packages/design-kit#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jasonsdevspace/design-kit.git",
        "directory": "packages/design-kit"
    },
    "bugs": {
        "url": "https://github.com/jasonsdevspace/design-kit/issues"
    },
    "type": "module",
    "exports": {
        "./tokens.css": "./dist/tokens.css",
        "./base.css": "./dist/base.css",
        "./components.css": "./dist/components.css",
        "./tokens.resolver.json": "./dist/tokens.resolver.json",
        "./theme": {
            "types": "./dist/theme.d.ts",
            "default": "./dist/theme.js"
        },
        "./controls": {
            "types": "./dist/controls.d.ts",
            "default": "./dist/controls.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "default": "./dist/react.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/*.css src/tokens.resolver.json dist/",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "react": "^19.3.0",
        "vite": ">=8"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    }
}
