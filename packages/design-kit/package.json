{
    "name": "@jasonsdevspace/design-kit",
    "version": "0.9.0",
    "description": "Design tokens, light and dark themes, and CSS components, with plain JavaScript functions or React hooks that make them work, from the demos on jasonsdevspace.com. Built to work by keyboard, screen reader and forced colors, with no flash of the wrong theme.",
    "keywords": [
        "design-tokens",
        "design-system",
        "css",
        "cascade-layers",
        "dark-mode",
        "light-dark",
        "theme",
        "vite-plugin",
        "react",
        "react-hooks",
        "accessibility",
        "wcag"
    ],
    "license": "MIT",
    "author": "Jason Poteet",
    "homepage": "https://github.com/jasonsdevspace/design-kit/tree/main/packages/design-kit#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jasonsdevspace/design-kit.git",
        "directory": "packages/design-kit"
    },
    "bugs": {
        "url": "https://github.com/jasonsdevspace/design-kit/issues"
    },
    "type": "module",
    "exports": {
        "./tokens.css": "./dist/tokens.css",
        "./base.css": "./dist/base.css",
        "./components.css": "./dist/components.css",
        "./tokens.resolver.json": "./dist/tokens.resolver.json",
        "./theme": {
            "types": "./dist/theme.d.ts",
            "default": "./dist/theme.js"
        },
        "./controls": {
            "types": "./dist/controls.d.ts",
            "default": "./dist/controls.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "default": "./dist/react.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.css",
        "./dist/controls.js"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/*.css src/tokens.resolver.json dist/",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "react": "^19.3.0",
        "vite": ">=8"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    }
}
