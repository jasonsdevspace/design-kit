{
    "name": "@jasonsdevspace/design-kit",
    "version": "0.1.0-next.2",
    "description": "Design tokens, base styles, page chrome and the theme script for the demos on jasonsdevspace.com.",
    "keywords": [
        "design-tokens",
        "design-system",
        "css",
        "cascade-layers",
        "dark-mode",
        "light-dark",
        "theme",
        "vite-plugin",
        "react"
    ],
    "license": "MIT",
    "author": "Jason Poteet",
    "homepage": "https://github.com/jasonsdevspace/design-kit/tree/main/packages/design-kit#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jasonsdevspace/design-kit.git",
        "directory": "packages/design-kit"
    },
    "bugs": {
        "url": "https://github.com/jasonsdevspace/design-kit/issues"
    },
    "type": "module",
    "exports": {
        "./tokens.css": "./dist/tokens.css",
        "./base.css": "./dist/base.css",
        "./components.css": "./dist/components.css",
        "./theme": {
            "types": "./dist/theme.d.ts",
            "default": "./dist/theme.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "default": "./dist/react.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/*.css dist/",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "react": "^19.3.0",
        "vite": ">=8"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    }
}
