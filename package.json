{
    "name": "design-kit",
    "private": true,
    "description": "The repository for @jasonsdevspace/design-kit.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "type-check": "tsc --noEmit && tsc -p scripts && tsc -p packages/design-kit/e2e && tsc -p packages/design-kit/smoke && tsc -p packages/site/e2e && tsc -p packages/site/bench",
        "build": "npm run build --workspaces --if-present",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prose": "node scripts/check-prose.mjs",
        "node-check": "node scripts/check-node.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "e2e": "playwright test",
        "site": "npm run build --workspace @jasonsdevspace/design-kit-site",
        "lighthouse": "node packages/site/bench/lighthouse.ts",
        "bench:package": "node scripts/record.mjs && prettier --write docs/benchmarks",
        "bench:pages": "node packages/site/bench/lighthouse.ts --record && prettier --write docs/benchmarks",
        "examples": "vitest run packages/design-kit/examples --update",
        "verify": "npm run type-check && npm run lint && npm run format:check && npm run prose && npm run node-check && npm run test:run",
        "prepare": "husky || true"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "chrome-launcher": "^1.2.3",
        "eslint": "^10.14.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lighthouse": "13.5.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,html}": [
            "prettier --write"
        ]
    },
    "allowScripts": {
        "fsevents": true
    }
}
