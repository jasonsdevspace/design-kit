{
    "name": "@jasonsdevspace/design-kit",
    "version": "0.0.0",
    "private": true,
    "description": "Design tokens, base styles and the theme script for the demos on jasonsdevspace.com.",
    "license": "MIT",
    "author": "Jason Poteet",
    "homepage": "https://github.com/jasonsdevspace/design-kit#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jasonsdevspace/design-kit.git"
    },
    "bugs": "https://github.com/jasonsdevspace/design-kit/issues",
    "type": "module",
    "exports": {
        "./tokens.css": "./src/tokens.css",
        "./base.css": "./src/base.css",
        "./theme": {
            "types": "./dist/theme.d.ts",
            "default": "./dist/theme.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        }
    },
    "files": [
        "src/*.css",
        "dist"
    ],
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "type-check": "tsc --noEmit && tsc -p scripts && tsc -p e2e",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prose": "node scripts/check-prose.mjs",
        "node-check": "node scripts/check-node.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "verify": "npm run type-check && npm run lint && npm run format:check && npm run prose && npm run node-check && npm run test:run",
        "prepare": "npm run build && (husky || true)",
        "e2e": "playwright test",
        "build": "tsc -p tsconfig.build.json"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,html}": [
            "prettier --write"
        ]
    },
    "allowScripts": {
        "unrs-resolver": true,
        "fsevents": true
    },
    "peerDependencies": {
        "vite": ">=8"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "eslint": "^10.14.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
